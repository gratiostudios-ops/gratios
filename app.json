{
  "expo": {
    "name": "Gratios",
    "slug": "fuse-mobile",
    "scheme": "avocado",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.avocado.fuse",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/gratios-app-icon.png",
        "backgroundColor": "#000000"
      },
      "icon": "./assets/brand/gratios-app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-padded-launcher",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/gratios-logo-white.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/brand/gratios-logo-white.png"
          }
        }
      ],
      "expo-notifications",
      "./plugins/with-notification-brand",
      "./plugins/with-gmail-launcher"
    ],
    "icon": "./assets/brand/gratios-app-icon.png",
    "extra": {
      "eas": {
        "projectId": "0049d64d-14be-407d-8fb5-5a58694a6cb5"
      }
    },
    "owner": "gratiostudios"
  }
}
