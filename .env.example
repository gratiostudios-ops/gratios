# Public configuration only; restart Metro after changing these values.
# Android USB/emulator: adb reverse tcp:4104 tcp:4104
EXPO_PUBLIC_GATEWAY_URL=http://127.0.0.1:4104
# Only literal true selects synthetic UI fixtures. Keep false for real accounts.
EXPO_PUBLIC_DEMO_MODE=false

# Expo project identifier for device push registration (public identifier, not a secret).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Set native build credentials externally; never commit google-services.json.
GOOGLE_SERVICES_JSON=
